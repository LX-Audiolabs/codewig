import { LineEdit, Button, VerticalBox, HorizontalBox, TextEdit, ScrollView } from "std-widgets.slint";

export struct RefEntry {
    name: string,
    /// Short one-liner for the list (right column). Not full syntax.
    summary: string,
    /// Inserted on right-click (primary template).
    syntax: string,
    /// Full help for the detail box (examples live here).
    detail: string,
    tag: string,
}

export component AppWindow inherits Window {
    in-out property <string> status: "disconnected";
    in-out property <string> output: "";
    in-out property <string> command: "";
    in-out property <string> ref-filter: "";
    in-out property <string> ref-tag: "";
    in-out property <string> help-text: "Click a command to see details. Right-click to insert syntax.";
    // Filter change → jump list to top (hidden rows used to leave scroll mid-list)
    changed ref-tag => { ref-list.viewport-y = 0; }
    changed ref-filter => { ref-list.viewport-y = 0; }
    in-out property <[RefEntry]> refs: [
        {
            name: "new track",
            summary: "create track + device + pattern",
            syntax: "new track(name).device(dev)",
            detail: "Create track + device + pattern in one line.\nUse .mute().clip(start) for beat-synced silent start.\n\nSyntax:\n  new track(name).device(dev)...\n\nExample:\n  new track(bass).device(Polymer).n(\"c e g\")",
            tag: "track",
        },
        {
            name: "t() / track()",
            summary: "reference track by name",
            syntax: "t(name)",
            detail: "Reference an existing track by name.\n\nSyntax:\n  t(name)  /  track(name)\n\nExamples:\n  t(kick)\n  t(bass)",
            tag: "track",
        },
        {
            name: "mute / unmute",
            summary: "mute tracks (timed optional)",
            syntax: "mute(kick) 4 @bar",
            detail: "Mute/unmute tracks by name or index.\nOptional: N bars auto-invert, @bar = next bar.\n\nSyntax:\n  mute(name1, ...)\n  mute(name) N\n  mute(name) @bar\n  mute(name) N @bar\n  unmute(...)\n\nExamples:\n  mute(kick)           // now\n  mute(kick) 4         // mute now, unmute after 4 bars\n  mute(kick) @bar      // mute at next bar\n  mute(kick) 8 @bar    // mute next bar, hold 8 bars, unmute\n  unmute(bass) @bar\n  mute(1, 3, 5)",
            tag: "track",
        },
        {
            name: "play / stop",
            summary: "transport start / stop",
            syntax: "play",
            detail: "Start or stop Bitwig transport.\n\nSyntax:\n  play\n  stop",
            tag: "transport",
        },
        {
            name: "tempo",
            summary: "set project tempo",
            syntax: "tempo 128",
            detail: "Set project tempo in BPM.\n\nSyntax:\n  tempo <bpm>\n\nExample:\n  tempo 128",
            tag: "transport",
        },
        {
            name: "s() / scene()",
            summary: "launch or stop a scene",
            syntax: "scene(verse).start",
            detail: "Launch or stop a scene by index (primary) or name.\n\nSyntax:\n  s(N).start | scene(N).start\n  s(name).start | scene(name).start\n  … .stop\n\nExamples:\n  s(0).start\n  scene(1).stop\n  scene(verse).start\n  s(Drop).start",
            tag: "scene",
        },
        {
            name: "c() / clip()",
            summary: "launch clip(s)",
            syntax: "c(bass.0).start",
            detail: "Launch one or more clips.\n\nSyntax:\n  c(t.slot).start\n  c(t.s1, t.s2).start\n  t(name).c(N).start\n\nExamples:\n  c(bass.0).start\n  c(bass.0, kick.1).start\n  t(bass).c(0).start",
            tag: "clip",
        },
        {
            name: ".clip(start/stop)",
            summary: "clip launch in fluent chain",
            syntax: ".clip(start)",
            detail: "In a fluent chain: launch or stop the clip.\n\nSyntax:\n  .clip(start)\n  .clip(stop)\n\nExample:\n  new track(b).device(P).n(\"c e\").clip(start)",
            tag: "clip",
        },
        {
            name: "n / notes",
            summary: "write MIDI notes",
            syntax: "bass: n \"c e g b\"",
            detail: "Write MIDI notes via mini-notation.\n\nSyntax:\n  track: n \"pattern\"\n\nExamples:\n  bass: n \"c e g b\"\n  lead: n \"0 2 4 7\"",
            tag: "notes",
        },
        {
            name: "mini-notation",
            summary: "pattern operators & symbols",
            syntax: "n \"c e g\"",
            detail: "Mini-notation operators:\n  ~ rest   [a b] group   * repeat   / slow\n  <a b> alternate   ! replicate   _ elongate\n  ? drop   @ el-N   | choice   (3,8) euclid\n  {a,b} polymetric   % ratio   : octave",
            tag: "notes",
        },
        {
            name: "transpose",
            summary: "shift notes up/down",
            syntax: "n \"c e g\" ^2",
            detail: "Transpose notes by semitones or scale degrees.\n\nSyntax:\n  ^N   semitones\n  ^^N  scale degrees\n\nExamples:\n  n \"c e g\" ^2   → D F# A\n  n \"0 2 4\" ^^1  → 1 3 5",
            tag: "notes",
        },
        {
            name: "chord",
            summary: "block chords / progressions",
            syntax: "pad: chord \"C Am F G\"",
            detail: "Block chords. Supports Roman numerals + scale.\n\nSyntax:\n  track: chord \"...\"\n\nExamples:\n  chord \"C Am F G\"\n  chord \"i iv v\"   (with k C minor)\n\nQualities: m  7  m7  maj7  dim  aug  sus4  9",
            tag: "notes",
        },
        {
            name: "arp",
            summary: "arpeggiate chord or notes",
            syntax: "bass: arp:up \"Cm7\"",
            detail: "Arpeggiate over one bar (session grid steps).\nIndex/slot write like n/chord.\n\nSyntax:\n  track: arp \"c e g\"\n  track: arp:up|down|updown|rand \"...\"\n\nPitch source:\n  notes:  \"c e g\" / \"0 2 4\" (with key)\n  chord:  \"C\" \"Am7\" \"iii\"\n\nExamples:\n  bass: arp \"c e g\"\n  lead: arp:down \"Cm7\"\n  pad: arp:updown \"Cmaj7\"\n  k C minor\n  bass: arp:rand \"i\"",
            tag: "notes",
        },
        {
            name: "d / drums",
            summary: "drum pattern on a track",
            syntax: "drums: d \"bd hh sd hh\"",
            detail: "Write drum patterns (MIDI aliases).\n\nSyntax:\n  drums: d \"pattern\"\n  drums:kit: d \"pattern\"\n\nExamples:\n  drums: d \"bd hh sd hh\"\n  drums:909: d \"bd hh sd\"\n  d:808 \"bd cp hh\"",
            tag: "drum",
        },
        {
            name: "beat()",
            summary: "create drum/percussion beat",
            syntax: "beat(4_)",
            detail: "Beat shortcuts on a 16-step grid.\n\nSyntax:\n  beat(4_)\n  beat(off)\n  beat:16(1,5,11,14)\n\nShortcuts:\n  4_   → 0,4,8,12\n  off  → 2,6,10,14\n  2_4 / bk2 → 0,8\n  :16(1,5,11,14) → explicit steps",
            tag: "drum",
        },
        {
            name: ".device() / .add()",
            summary: "insert instrument or FX",
            syntax: ".device(Polymer)",
            detail: "Insert curated devices only (allowlist).\n\nSyntax:\n  .device(Polymer)\n  .device(v9 kick)\n  .add(Delay+)\n  .device(layer)\n\nExamples:\n  new track(b).device(Polymer).add(Delay+)\n  new track(kick).device(v9 kick).beat(4_)\n\nInstruments:\n  Polymer  Polysynth  Organ\n  stock drums: v0 Cymbal … v9 Tom\n  write: v9 kick  |  v9kick  |  V9 Kick\n\nLayer + FX:\n  Instrument Layer  Filter  Reverb  Delay+  Chorus+  Saturator\n\nNot allowed:\n  Sampler  Drum Machine  VSTs\n\nDrums: one track = one module = one MIDI for clip hits.\nNot GM multi-pad (bd/hh/sd) — that needs Drum Machine.",
            tag: "device",
        },
        {
            name: ": params",
            summary: "snapshot device parameters",
            syntax: "t(bass).d(Polymer): cutoff(0.3)",
            detail: "Set params on a device that already exists — one value now (snapshot).\nNo ramps, sequences, or automation. Smooth control stays in Bitwig / hardware.\n\nSyntax:\n  t(name).d(dev): param(val)...\n  track: n \"...\" +param:val\n\nExamples:\n  t(bass).d(Polymer): cutoff(0.3) res(0.7)\n  bass: n \"c e g\" +cutoff:0.3",
            tag: "device",
        },
        {
            name: "Polymer",
            summary: "wavetable synth",
            syntax: "Polymer",
            detail: "Insertable instrument. Wavetable synth.\n\nAliases: Polymer / poly",
            tag: "synth",
        },
        {
            name: "Polysynth",
            summary: "VA polysynth",
            syntax: "Polysynth",
            detail: "Insertable instrument. VA polysynth.\n\nAliases: Polysynth / psynth",
            tag: "synth",
        },
        {
            name: "Organ",
            summary: "tonewheel organ",
            syntax: "Organ",
            detail: "Insertable instrument. Tonewheel organ.",
            tag: "synth",
        },
        {
            name: "Instrument Layer",
            summary: "multi-pad drum shell",
            syntax: "layer",
            detail: "Insertable shell for multi-pad kits.\nOr single pad on track: .device(kick.v9)\n\nAlias: layer",
            tag: "drum",
        },
        {
            name: "drum MIDI aliases",
            summary: "bd / hh / sd note map",
            syntax: "bd hh sd",
            detail: "Percussion rhythm is fluent .beat(...), not hit markers.\n\nWorkflow:\n  new track(kick).device(v9 kick).beat(4_)\n  kick: n \"c1\"     // exact notes if you want\n\nNo d \"bd hh\" — that was Drum Machine / Strudel.",
            tag: "drum",
        },
        {
            name: "Delay+",
            summary: "stereo delay FX",
            syntax: "Delay+",
            detail: "Insertable stereo delay.\n\nAliases: Delay+ / Delay-2 / dly2",
            tag: "fx",
        },
        {
            name: "Reverb",
            summary: "plate reverb FX",
            syntax: "Reverb",
            detail: "Insertable plate reverb.\n\nAliases: Reverb / rev",
            tag: "fx",
        },
        {
            name: "Filter",
            summary: "multi-mode filter FX",
            syntax: "Filter",
            detail: "Insertable multi-mode filter.\n\nAliases: Filter / filt",
            tag: "fx",
        },
        {
            name: "Chorus+",
            summary: "chorus FX",
            syntax: "Chorus+",
            detail: "Insertable chorus.\n\nAliases: Chorus+ / Chorus / chor",
            tag: "fx",
        },
        {
            name: "Saturator",
            summary: "drive / distortion FX",
            syntax: "Saturator",
            detail: "Insertable drive (alias Distortion).\n\nAliases: Saturator / dist",
            tag: "fx",
        },
        {
            name: "k / key",
            summary: "set key and scale",
            syntax: "k C minor",
            detail: "Set key for scale degrees.\n\nSyntax:\n  k <root> <scale>\n\nExamples:\n  k C minor\n  k D major\n\nScales:\n  major minor dorian phrygian\n  lydian mixolydian locrian pentatonic blues",
            tag: "key",
        },
        {
            name: "mode",
            summary: "switch REPL mode",
            syntax: "mode music",
            detail: "Switch REPL mode.\n\nSyntax:\n  mode cmd\n  mode music",
            tag: "other",
        },
        {
            name: "> passthrough",
            summary: "run raw CLIwig command",
            syntax: "> track list",
            detail: "Run a CLIwig command from music mode.\n\nSyntax:\n  > <cliwig command>\n\nExamples:\n  > track list\n  > device add Filter",
            tag: "other",
        },
    ];

    callback send-command();
    callback reconnect();
    callback insert-command(string);
    callback show-help(string);
    /// Substring match (case-insensitive). Slint has no string.contains — Rust implements it.
    pure callback text-matches(haystack: string, needle: string) -> bool;

    // LX AudioLabs-inspired dark theme
    out property <color> accent: #ff731a;
    out property <color> bg: #171717;
    out property <color> panel: #1c1c1c;
    out property <color> control: #262626;
    out property <color> text: #f5f5f5;
    out property <color> muted: #8c8c99;
    out property <color> connected: #00bf4d;
    out property <color> disconnected: #e04545;
    out property <color> hover: #2a2a2a;
    out property <color> tag-active: #ff731a;
    out property <color> tag-bg: #2a2a2a;

    title: "codewig-live";
    preferred-width: 1200px;
    preferred-height: 700px;
    // Allow shrink even when status text is long (disconnected errors)
    min-width: 720px;
    min-height: 420px;
    background: bg;

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        // Main area
        VerticalBox {
            spacing: 8px;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            HorizontalBox {
                height: 36px;
                Text {
                    text: "codewig-live";
                    font-size: 18px;
                    font-weight: 700;
                    color: accent;
                }
                Rectangle { horizontal-stretch: 1; }
                // Long "disconnected (...)" must not lock window min-width
                Text {
                    text: root.status;
                    color: root.status == "connected" ? connected : disconnected;
                    font-weight: 600;
                    max-width: 220px;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Button {
                    text: "Reconnect";
                    height: 28px;
                    clicked => { root.reconnect(); }
                }
            }

            Rectangle {
                background: panel;
                border-radius: 5px;
                vertical-stretch: 1;
                min-height: 120px;

                TextEdit {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    text: root.output;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 12px;
                }
            }

            HorizontalBox {
                height: 32px;
                LineEdit {
                    text <=> root.command;
                    placeholder-text: "♫  bass: n \"c e g\" +cutoff:0.3";
                    accepted => { root.send-command(); }
                    horizontal-stretch: 1;
                    height: 32px;
                    font-size: 13px;
                }
                Button {
                    text: "Send";
                    height: 32px;
                    clicked => { root.send-command(); }
                }
            }
        }

        // ── Sidebar: fixed width, full height; list + help share remaining space ──
        Rectangle {
            width: 360px;
            horizontal-stretch: 0;
            vertical-stretch: 1;
            background: panel;
            border-radius: 5px;

            VerticalBox {
                width: 100%;
                height: 100%;
                padding: 10px;
                spacing: 6px;
                // no alignment:start — that packs children to preferred size and
                // leaves empty dead space under tags instead of growing list/help

                Text {
                    text: "WIGSCRIPT";
                    font-size: 14px;
                    font-weight: 700;
                    color: accent;
                    vertical-stretch: 0;
                }

                Text {
                    text: "Click = details · Right-click = insert";
                    font-size: 11px;
                    color: muted;
                    vertical-stretch: 0;
                }

                LineEdit {
                    text <=> root.ref-filter;
                    placeholder-text: "Search commands...";
                    height: 28px;
                    font-size: 12px;
                    vertical-stretch: 0;
                }

                // Tag bar (fixed height; wrap not needed — shorter labels)
                HorizontalBox {
                    height: 28px;
                    spacing: 3px;
                    vertical-stretch: 0;

                    tag-all := Rectangle {
                        height: 24px; width: 32px;
                        background: root.ref-tag == "" || root.ref-tag == "all" ? tag-active : tag-bg;
                        border-radius: 4px;
                        ta0 := TouchArea { clicked => { root.ref-tag = ""; } }
                        Text { x: 6px; y: 4px; text: "all"; font-size: 11px; color: root.ref-tag == "" || root.ref-tag == "all" ? text : muted; }
                    }
                    tag-track := Rectangle {
                        height: 24px; width: 42px;
                        background: root.ref-tag == "track" ? tag-active : tag-bg; border-radius: 4px;
                        ta1 := TouchArea { clicked => { if root.ref-tag == "track" { root.ref-tag = ""; } else { root.ref-tag = "track"; } } }
                        Text { x: 5px; y: 4px; text: "track"; font-size: 11px; color: root.ref-tag == "track" ? text : muted; }
                    }
                    tag-transport := Rectangle {
                        height: 24px; width: 56px;
                        background: root.ref-tag == "transport" ? tag-active : tag-bg; border-radius: 4px;
                        ta2 := TouchArea { clicked => { if root.ref-tag == "transport" { root.ref-tag = ""; } else { root.ref-tag = "transport"; } } }
                        Text { x: 3px; y: 4px; text: "transport"; font-size: 11px; color: root.ref-tag == "transport" ? text : muted; }
                    }
                    tag-scene := Rectangle {
                        height: 24px; width: 42px;
                        background: root.ref-tag == "scene" ? tag-active : tag-bg; border-radius: 4px;
                        ta3 := TouchArea { clicked => { if root.ref-tag == "scene" { root.ref-tag = ""; } else { root.ref-tag = "scene"; } } }
                        Text { x: 5px; y: 4px; text: "scene"; font-size: 11px; color: root.ref-tag == "scene" ? text : muted; }
                    }
                    tag-clip := Rectangle {
                        height: 24px; width: 32px;
                        background: root.ref-tag == "clip" ? tag-active : tag-bg; border-radius: 4px;
                        ta4 := TouchArea { clicked => { if root.ref-tag == "clip" { root.ref-tag = ""; } else { root.ref-tag = "clip"; } } }
                        Text { x: 6px; y: 4px; text: "clip"; font-size: 11px; color: root.ref-tag == "clip" ? text : muted; }
                    }
                    tag-notes := Rectangle {
                        height: 24px; width: 42px;
                        background: root.ref-tag == "notes" ? tag-active : tag-bg; border-radius: 4px;
                        ta5 := TouchArea { clicked => { if root.ref-tag == "notes" { root.ref-tag = ""; } else { root.ref-tag = "notes"; } } }
                        Text { x: 5px; y: 4px; text: "notes"; font-size: 11px; color: root.ref-tag == "notes" ? text : muted; }
                    }
                    tag-drum := Rectangle {
                        height: 24px; width: 40px;
                        background: root.ref-tag == "drum" ? tag-active : tag-bg; border-radius: 4px;
                        ta6 := TouchArea { clicked => { if root.ref-tag == "drum" { root.ref-tag = ""; } else { root.ref-tag = "drum"; } } }
                        Text { x: 5px; y: 4px; text: "drum"; font-size: 11px; color: root.ref-tag == "drum" ? text : muted; }
                    }
                }

                // Command list — takes remaining height (scrolls)
                // visible:false alone still left row height → long empty scroll; collapse height + reset viewport
                ref-list := ScrollView {
                    vertical-stretch: 3;
                    min-height: 100px;

                    VerticalBox {
                        width: 100%;
                        spacing: 0px;
                        alignment: stretch;

                        for entry in root.refs: Rectangle {
                            // substring via pure callback text-matches (Slint has no string.contains)
                            property <bool> shown:
                                (root.ref-filter == ""
                                  || root.text-matches(entry.name, root.ref-filter)
                                  || root.text-matches(entry.summary, root.ref-filter)
                                  || root.text-matches(entry.syntax, root.ref-filter)
                                  || root.text-matches(entry.tag, root.ref-filter))
                                && (root.ref-tag == "" || root.ref-tag == "all" || entry.tag == root.ref-tag);
                            // collapse layout space when filtered out (not just hide paint)
                            height: shown ? 30px : 0px;
                            width: 100%;
                            visible: shown;
                            background: ta-entry.has-hover ? hover : transparent;
                            border-radius: 3px;
                            clip: true;

                            ta-entry := TouchArea {
                                width: 100%;
                                height: 100%;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        root.show-help(entry.detail);
                                    }
                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                        root.insert-command(entry.syntax);
                                    }
                                }
                            }

                            // name | short summary — syntax/examples only in detail box
                            Text {
                                x: 8px;
                                y: 0px;
                                width: 128px;
                                height: 100%;
                                text: entry.name;
                                font-size: 12px;
                                font-weight: 500;
                                color: text;
                                wrap: no-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                            Text {
                                x: 140px;
                                y: 0px;
                                width: parent.width - 148px;
                                height: 100%;
                                text: entry.summary;
                                font-size: 11px;
                                color: muted;
                                wrap: no-wrap;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                        }
                    }
                }

                // Help / detail — shares remaining height with list
                Rectangle {
                    vertical-stretch: 2;
                    min-height: 90px;
                    background: control;
                    border-radius: 4px;
                    clip: true;

                    Text {
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        text: root.help-text;
                        color: text;
                        font-size: 12px;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
