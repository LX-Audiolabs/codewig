import { LineEdit, Button, VerticalBox, HorizontalBox, TextEdit, ScrollView } from "std-widgets.slint";

export struct RefEntry {
    name: string,
    /// Short one-liner for the list (right column). Not full syntax.
    summary: string,
    /// Inserted on right-click (primary template).
    syntax: string,
    /// Full help for the detail box (examples live here).
    detail: string,
    tag: string,
}

export struct DeviceEntry {
    name: string,
    aliases: string,
    /// Inserted on right-click.
    syntax: string,
    /// One-liner for the list only (param dump loaded on click via device-detail).
    summary: string,
}

export component AppWindow inherits Window {
    in-out property <string> status: "disconnected";
    in-out property <string> output: "";
    in-out property <string> command: "";
    in-out property <string> ref-filter: "";
    in-out property <string> ref-tag: "";
    in-out property <string> active-tab: "commands";
    in-out property <string> help-text: "Click a command to see details. Right-click to insert syntax.";
    in-out property <[RefEntry]> refs: [];

    in-out property <[DeviceEntry]> devices: [];

    callback send-command();
    callback reconnect();
    callback insert-command(string);
    callback show-help(string);
    /// Rescan devices/*.yaml and refresh Devices tab.
    callback reload-devices();
    /// Lazy: full parameter list for one device (by bitwig name / id / alias).
    pure callback device-detail(name: string) -> string;
    /// Substring match (case-insensitive). Slint has no string.contains — Rust implements it.
    pure callback text-matches(haystack: string, needle: string) -> bool;

    changed active-tab => {
        help-text = active-tab == "commands"
            ? "Click a command to see details. Right-click to insert syntax."
            : "Alias catalog (devices/aliases.yml). Click = page-model cheat sheet · Right-click = insert · ↻ = reload";
    }

    // LX AudioLabs-inspired dark theme
    out property <color> accent: #ff731a;
    out property <color> bg: #171717;
    out property <color> panel: #1c1c1c;
    out property <color> control: #262626;
    out property <color> text: #f5f5f5;
    out property <color> muted: #8c8c99;
    out property <color> connected: #00bf4d;
    out property <color> disconnected: #e04545;
    out property <color> hover: #2a2a2a;
    out property <color> tag-active: #ff731a;
    out property <color> tag-bg: #2a2a2a;

    title: "codewig-live";
    preferred-width: 1200px;
    preferred-height: 700px;
    // Allow shrink even when status text is long (disconnected errors)
    min-width: 720px;
    min-height: 420px;
    background: bg;

    HorizontalBox {
        padding: 12px;
        spacing: 12px;

        // Main area
        VerticalBox {
            spacing: 8px;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            HorizontalBox {
                height: 36px;
                Text {
                    text: "codewig-live";
                    font-size: 18px;
                    font-weight: 700;
                    color: accent;
                }
                Rectangle { horizontal-stretch: 1; }
                // Long "disconnected (...)" must not lock window min-width
                Text {
                    text: root.status;
                    color: root.status == "connected" ? connected : disconnected;
                    font-weight: 600;
                    max-width: 220px;
                    overflow: elide;
                    wrap: no-wrap;
                }
                Button {
                    text: "Reconnect";
                    height: 28px;
                    clicked => { root.reconnect(); }
                }
            }

            Rectangle {
                background: panel;
                border-radius: 5px;
                vertical-stretch: 1;
                min-height: 120px;

                TextEdit {
                    x: 8px;
                    y: 8px;
                    width: parent.width - 16px;
                    height: parent.height - 16px;
                    text: root.output;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 12px;
                }
            }

            HorizontalBox {
                height: 32px;
                LineEdit {
                    text <=> root.command;
                    placeholder-text: "♫  bass: n \"c e g\" +cutoff:0.3";
                    accepted => { root.send-command(); }
                    horizontal-stretch: 1;
                    height: 32px;
                    font-size: 13px;
                }
                Button {
                    text: "Send";
                    height: 32px;
                    clicked => { root.send-command(); }
                }
            }
        }

        // ── Sidebar: fixed width, full height; list + help share remaining space ──
        Rectangle {
            width: 360px;
            horizontal-stretch: 0;
            vertical-stretch: 1;
            background: panel;
            border-radius: 5px;

            VerticalBox {
                width: 100%;
                height: 100%;
                padding: 10px;
                spacing: 6px;
                // no alignment:start — that packs children to preferred size and
                // leaves empty dead space under tags instead of growing list/help

                Text {
                    text: "WIGSCRIPT";
                    font-size: 14px;
                    font-weight: 700;
                    color: accent;
                    vertical-stretch: 0;
                }

                Text {
                    text: "Click = details · Right-click = insert";
                    font-size: 11px;
                    color: muted;
                    vertical-stretch: 0;
                }

                LineEdit {
                    text <=> root.ref-filter;
                    placeholder-text: "Search...";
                    height: 28px;
                    font-size: 12px;
                    vertical-stretch: 0;
                }

                // Tabs: Commands | Devices | reload catalog
                HorizontalBox {
                    height: 28px;
                    spacing: 3px;
                    vertical-stretch: 0;

                    tab-commands := Rectangle {
                        height: 24px; width: 70px;
                        background: root.active-tab == "commands" ? tag-active : tag-bg;
                        border-radius: 4px;
                        TouchArea { clicked => { root.active-tab = "commands"; } }
                        Text { x: 8px; y: 4px; text: "Commands"; font-size: 11px; color: root.active-tab == "commands" ? text : muted; }
                    }
                    tab-devices := Rectangle {
                        height: 24px; width: 58px;
                        background: root.active-tab == "devices" ? tag-active : tag-bg;
                        border-radius: 4px;
                        TouchArea { clicked => { root.active-tab = "devices"; } }
                        Text { x: 8px; y: 4px; text: "Devices"; font-size: 11px; color: root.active-tab == "devices" ? text : muted; }
                    }
                    // Rescan devices/*.yaml (drop a new YAML → click reload)
                    tab-reload := Rectangle {
                        height: 24px; width: 28px;
                        background: reload-ta.has-hover ? hover : tag-bg;
                        border-radius: 4px;
                        reload-ta := TouchArea {
                            clicked => {
                                root.active-tab = "devices";
                                root.reload-devices();
                            }
                        }
                        Text {
                            x: 0px; y: 0px; width: 100%; height: 100%;
                            text: "↻";
                            font-size: 14px;
                            color: muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Commands tab ──
                if root.active-tab == "commands": VerticalBox {
                    vertical-stretch: 1;
                    spacing: 6px;

                    // Tag bar (fixed height; wrap not needed — shorter labels)
                    HorizontalBox {
                        height: 28px;
                        spacing: 3px;
                        vertical-stretch: 0;

                        tag-all := Rectangle {
                            height: 24px; width: 32px;
                            background: root.ref-tag == "" || root.ref-tag == "all" ? tag-active : tag-bg;
                            border-radius: 4px;
                            ta0 := TouchArea { clicked => { root.ref-tag = ""; } }
                            Text { x: 6px; y: 4px; text: "all"; font-size: 11px; color: root.ref-tag == "" || root.ref-tag == "all" ? text : muted; }
                        }
                        tag-track := Rectangle {
                            height: 24px; width: 42px;
                            background: root.ref-tag == "track" ? tag-active : tag-bg; border-radius: 4px;
                            ta1 := TouchArea { clicked => { if root.ref-tag == "track" { root.ref-tag = ""; } else { root.ref-tag = "track"; } } }
                            Text { x: 5px; y: 4px; text: "track"; font-size: 11px; color: root.ref-tag == "track" ? text : muted; }
                        }
                        tag-transport := Rectangle {
                            height: 24px; width: 56px;
                            background: root.ref-tag == "transport" ? tag-active : tag-bg; border-radius: 4px;
                            ta2 := TouchArea { clicked => { if root.ref-tag == "transport" { root.ref-tag = ""; } else { root.ref-tag = "transport"; } } }
                            Text { x: 3px; y: 4px; text: "transport"; font-size: 11px; color: root.ref-tag == "transport" ? text : muted; }
                        }
                        tag-scene := Rectangle {
                            height: 24px; width: 42px;
                            background: root.ref-tag == "scene" ? tag-active : tag-bg; border-radius: 4px;
                            ta3 := TouchArea { clicked => { if root.ref-tag == "scene" { root.ref-tag = ""; } else { root.ref-tag = "scene"; } } }
                            Text { x: 5px; y: 4px; text: "scene"; font-size: 11px; color: root.ref-tag == "scene" ? text : muted; }
                        }
                        tag-clip := Rectangle {
                            height: 24px; width: 32px;
                            background: root.ref-tag == "clip" ? tag-active : tag-bg; border-radius: 4px;
                            ta4 := TouchArea { clicked => { if root.ref-tag == "clip" { root.ref-tag = ""; } else { root.ref-tag = "clip"; } } }
                            Text { x: 6px; y: 4px; text: "clip"; font-size: 11px; color: root.ref-tag == "clip" ? text : muted; }
                        }
                        tag-notes := Rectangle {
                            height: 24px; width: 42px;
                            background: root.ref-tag == "notes" ? tag-active : tag-bg; border-radius: 4px;
                            ta5 := TouchArea { clicked => { if root.ref-tag == "notes" { root.ref-tag = ""; } else { root.ref-tag = "notes"; } } }
                            Text { x: 5px; y: 4px; text: "notes"; font-size: 11px; color: root.ref-tag == "notes" ? text : muted; }
                        }
                        tag-drum := Rectangle {
                            height: 24px; width: 40px;
                            background: root.ref-tag == "drum" ? tag-active : tag-bg; border-radius: 4px;
                            ta6 := TouchArea { clicked => { if root.ref-tag == "drum" { root.ref-tag = ""; } else { root.ref-tag = "drum"; } } }
                            Text { x: 5px; y: 4px; text: "drum"; font-size: 11px; color: root.ref-tag == "drum" ? text : muted; }
                        }
                    }

                    // Command list — takes remaining height (scrolls)
                    ref-list := ScrollView {
                        vertical-stretch: 3;
                        min-height: 100px;

                        VerticalBox {
                            width: 100%;
                            spacing: 0px;
                            alignment: stretch;

                            for entry in root.refs: Rectangle {
                                // substring via pure callback text-matches (Slint has no string.contains)
                                property <bool> shown:
                                    (root.ref-filter == ""
                                      || root.text-matches(entry.name, root.ref-filter)
                                      || root.text-matches(entry.summary, root.ref-filter)
                                      || root.text-matches(entry.syntax, root.ref-filter)
                                      || root.text-matches(entry.tag, root.ref-filter))
                                    && (root.ref-tag == "" || root.ref-tag == "all" || entry.tag == root.ref-tag);
                                // collapse layout space when filtered out (not just hide paint)
                                height: shown ? 30px : 0px;
                                width: 100%;
                                visible: shown;
                                background: ta-entry.has-hover ? hover : transparent;
                                border-radius: 3px;
                                clip: true;

                                ta-entry := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                            root.show-help(entry.detail);
                                        }
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.insert-command(entry.syntax);
                                        }
                                    }
                                }

                                // name | short summary — syntax/examples only in detail box
                                Text {
                                    x: 8px;
                                    y: 0px;
                                    width: 128px;
                                    height: 100%;
                                    text: entry.name;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: text;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    x: 140px;
                                    y: 0px;
                                    width: parent.width - 148px;
                                    height: 100%;
                                    text: entry.summary;
                                    font-size: 11px;
                                    color: muted;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }

                // ── Devices tab ──
                if root.active-tab == "devices": VerticalBox {
                    vertical-stretch: 1;
                    spacing: 6px;

                    dev-list := ScrollView {
                        vertical-stretch: 3;
                        min-height: 100px;

                        VerticalBox {
                            width: 100%;
                            spacing: 0px;
                            alignment: stretch;

                            for entry in root.devices: Rectangle {
                                property <bool> shown:
                                    root.ref-filter == ""
                                    || root.text-matches(entry.name, root.ref-filter)
                                    || root.text-matches(entry.aliases, root.ref-filter)
                                    || root.text-matches(entry.summary, root.ref-filter);
                                height: shown ? 30px : 0px;
                                width: 100%;
                                visible: shown;
                                background: ta-dev.has-hover ? hover : transparent;
                                border-radius: 3px;
                                clip: true;

                                ta-dev := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    pointer-event(event) => {
                                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                            // Lazy: full param dump only when selected
                                            root.show-help(root.device-detail(entry.name));
                                        }
                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                            root.insert-command(entry.syntax);
                                        }
                                    }
                                }

                                Text {
                                    x: 8px;
                                    y: 0px;
                                    width: 160px;
                                    height: 100%;
                                    text: entry.name;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: text;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                                Text {
                                    x: 172px;
                                    y: 0px;
                                    width: parent.width - 180px;
                                    height: 100%;
                                    text: entry.summary;
                                    font-size: 11px;
                                    color: muted;
                                    wrap: no-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }

                // Help / detail — shares remaining height with list
                Rectangle {
                    vertical-stretch: 2;
                    min-height: 90px;
                    background: control;
                    border-radius: 4px;
                    clip: true;

                    Text {
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: parent.height - 20px;
                        text: root.help-text;
                        color: text;
                        font-size: 12px;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
